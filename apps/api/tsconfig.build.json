{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    // nest-cli deletes dist before building; an incremental cache would then
    // decide nothing needs emitting and leave dist empty.
    "incremental": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "dist", "prisma", "**/*spec.ts"]
}
