DATABASE_URL="postgresql://rs3:rs3dev@localhost:5432/rs3_gim?schema=public"
# Prisma connection pool. Its own default is `cpus * 2 + 1` — about 5 on a small
# container, which is not enough once several tabs are polling: reads hold
# connections while serialising inventories and writes queue behind them.
# Applied automatically unless DATABASE_URL already sets connection_limit.
DB_POOL_SIZE=20
# Seconds a query waits for a free connection before failing.
DB_POOL_TIMEOUT=15
# Some hosts inject PORT themselves; only set it when running the API directly.
PORT=3000
# Comma-separated list of allowed browser origins.
# Defaults when unset:
#   NODE_ENV=production -> https://rs3groupiron.men,https://www.rs3groupiron.men
#   otherwise           -> http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Set to 1 to auto-seed demo data on boot when the DB is empty.
# Seeding is skipped in production unless this is set.
SEED_DEMO=
# Set to 1 to enable POST /api/reset-fake-data (wipes the DB!). The API refuses
# to start if this is set while NODE_ENV=production.
ALLOW_DEV_RESET=
# The seeded "Demo Group" is public sample data: readable with no token and
# read-only. Set to 1 to allow writes to it (needs its token from the DB).
DEMO_WRITABLE=
# Number of reverse-proxy hops in front of the API (e.g. 1 behind nginx/Caddy).
# Leave empty when clients hit the API directly.
TRUST_PROXY=
# Origin(s) achievement screenshots may be hosted on, comma separated.
# An achievement's image_url is only stored when its origin matches exactly;
# when this is unset, any image_url is rejected with a 400.
CDN_BASE_URL=https://cdn.rs3groupiron.men

# --- Cloudflare R2 (achievement screenshot uploads) ---
# All four are required for uploads; leave any blank and the upload endpoint
# returns 503 while the rest of the API keeps working. CDN_BASE_URL above is
# the bucket's public custom domain.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Separate PRIVATE bucket for nightly database dumps. Must NOT be R2_BUCKET:
# that one is public behind CDN_BASE_URL, and a dump contains every group's
# token. The backup refuses to run if the two match.
# Create it in Cloudflare R2 with no public access and no custom domain.
R2_BACKUP_BUCKET=
# Largest screenshot accepted, in bytes. Signed into the upload URL, so a
# client cannot exceed it. Defaults to 5242880 (5 MiB) when unset.
UPLOAD_MAX_BYTES=5242880

# Directory holding RS3 gameval dumps: achievement, quest, inv and the var_*
# tables (var_player, var_client, var_clan, var_clan_setting, var_npc,
# var_object, var_player_group), one <kind>.json each.
# Defaults to ./data/gamevals relative to the API working directory.
GAMEVALS_DIR=
# Quest dump (id, gameval, name, questPoints...) used for achievement titles.
# Defaults to ./data/quests.json.
QUESTS_FILE=

# Set in production for Express/Nest production behaviour.
NODE_ENV=

# --- OpenTelemetry (APM) ---
# Base OTLP/HTTP endpoint. Tracing is OFF entirely while this is unset, so an
# unconfigured deploy behaves exactly as it did before instrumentation.
# The SDK appends /v1/traces and /v1/metrics itself — give it the base only.
# NOTE: must be reachable from the API host — a localhost endpoint only works
# when the collector runs on the same box.
#   Grafana Cloud -> https://otlp-gateway-<REGION>.grafana.net/otlp
#                    (keep the /otlp suffix, no /v1/traces)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Auth for a hosted backend, comma separated. For Grafana Cloud the username is
# the numeric instance ID and the password is a Cloud Access Policy token with
# the traces:write and metrics:write scopes. Both come from the OpenTelemetry
# tile -> Configure in your Grafana Cloud stack. Build the value with:
#   node -e "console.log('Authorization=Basic '+Buffer.from('INSTANCE_ID:TOKEN').toString('base64'))"
# Leave empty for a collector that needs no auth.
OTEL_EXPORTER_OTLP_HEADERS=
# Grafana Cloud's gateway speaks http/protobuf, which is already what the
# exporter package sends; set it explicitly so the intent is obvious.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Service identity shown in the APM UI.
OTEL_SERVICE_NAME=rs3-gim-api
OTEL_SERVICE_VERSION=
# Fraction of traces kept. Sample everything locally; lower it in production
# once you know the request volume (0.1 = 10%).
#   OTEL_TRACES_SAMPLER=parentbased_always_on      -> keep everything
#   OTEL_TRACES_SAMPLER=parentbased_traceidratio   -> keep OTEL_TRACES_SAMPLER_ARG
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0
# How often metrics are pushed, in ms. Defaults to 60000.
OTEL_METRIC_EXPORT_INTERVAL=
# Set to "debug" to print the exporter's own diagnostics. First thing to try
# when the backend shows no spans.
OTEL_LOG_LEVEL=

# --- Server-sent events capacity ---
# Concurrent event streams allowed, per group and in total. Each stream holds an
# nginx client connection AND an upstream connection, so the total must stay
# under half of nginx's worker_connections (deploy/configure.sh sets 4096).
# Over the cap the API answers 503 and the client falls back to polling.
SSE_MAX_PER_GROUP=256
SSE_MAX_TOTAL=1800
